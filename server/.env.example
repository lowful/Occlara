# Server
PORT=3000

# Supabase, REQUIRED. Every license lookup goes through it, so the server boots
# without these and then fails every single request.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# Gates /api/admin/*. Leave unset and those routes always answer 401.
ADMIN_PASSWORD=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# STRIPE_PRICE_WEEKLY, MONTHLY and LIFETIME are no longer read: the site's own
# create-checkout sells the plans, and the old public checkout here answers 410.

# App URLs
CLIENT_URL=https://occlara.app

# ─── AI model provider ────────────────────────────────────────────────────────
# Leave AI_API_KEY empty to keep using Gemini (GEMINI_API_KEY).
# To switch to OpenRouter + Qwen2.5-VL (recommended, prepaid, cheap):
#   1. Create an OpenRouter account and add credits, copy your key (sk-or-...).
#   2. Set the vars below and redeploy.
# Any OpenAI-compatible endpoint works: just change AI_BASE_URL + model slugs.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
# Unset: every call to OpenRouter asks for providers that neither store nor
# train on the frames (provider: { data_collection: 'deny' }). Set to allow to
# send the request without that preference, without a deploy.
# AI_DATA_COLLECTION=allow
# Qwen3-VL is great at reading game HUDs. Pricing per 1M tokens:
#   qwen/qwen3-vl-235b-a22b-instruct  $0.20 in / $0.88 out   (fast, no reasoning)
#   qwen/qwen3-vl-235b-a22b-thinking  reasons first, better analysis, ~8-12s+ (too
#                                     slow for the live loop, times out ~2/3 of frames)
#   qwen/qwen3-vl-30b-a3b-instruct    $0.13 in / $0.52 out   (cheapest/fastest)
# ACCURACY-FIRST (current default): thinking on both, including live tips. Tips
# take ~15-25s but carry the reasoning model's deeper reads. The server sizes
# reasoning headroom + timeouts for this and strips <think> (see chatCall); the
# client analyze timeout is 30s to match. Set AI_VISION_MODEL to the instruct
# model for fast tips (~4-7s) if you would rather have speed than reasoning.
AI_VISION_MODEL=qwen/qwen3-vl-235b-a22b-thinking
AI_TEXT_MODEL=qwen/qwen3-vl-235b-a22b-thinking
# AI_PROVIDER=openai   # auto-set to 'openai' when AI_API_KEY is present; 'gemini' otherwise

# Existing (unchanged)
# GEMINI_API_KEY=...

# HenrikDev API key (docs.henrikdev.xyz). Powers /player-stats and the match
# record. tracker.gg is NOT used: its terms forbid its internal API.
HENRIKDEV_API_KEY=
