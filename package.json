{
  "name": "occlara",
  "version": "6.7.0",
  "description": "Occlara, an AI coaching overlay for Valorant and Marvel Rivals, with a League of Legends learning section. Reads the screen, never the game.",
  "main": "src/main/index.js",
  "scripts": {
    "bench:models": "node scripts/bench-models.js",
    "check:clientboot": "node scripts/check-client-boot.js",
    "check:config": "node scripts/check-config-bridge.js",
    "check:dom": "node scripts/check-dom-ids.js",
    "check:gameswitch": "node scripts/check-game-switch.js",
    "check:i18n": "node scripts/check-i18n.js",
    "check:learnrole": "node scripts/check-learn-role.js",
    "check:lolreview": "node scripts/check-lol-review-window.js",
    "check:palette": "node scripts/check-palette.js",
    "check:playbook": "node scripts/check-playbook.js",
    "check:release": "node scripts/check-release-ready.js",
    "check:rivalsknowledge": "node scripts/check-rivals-knowledge.js",
    "check:rivalsreview": "node scripts/check-rivals-review-window.js",
    "check:server": "node scripts/check-server-boot.js",
    "check:splash": "node scripts/check-splash-timing.js",
    "dev": "electron . --dev",
    "dist": "electron-builder --win --mac",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "generate-icon": "node scripts/generate-icon.js",
    "publish:download": "node scripts/publish-download.js",
    "release": "node scripts/check-release-ready.js && electron-builder --win --publish always && node scripts/publish-download.js",
    "review:log": "node scripts/review-log.js",
    "start": "electron .",
    "sync:busts": "node scripts/sync-agent-busts.js",
    "sync:lol": "node scripts/sync-lol.js",
    "sync:patch": "node scripts/sync-patch-notes.js",
    "sync:rivals": "node scripts/sync-rivals-data.js",
    "sync:valorant": "node scripts/sync-valorant-data.js",
    "test": "node scripts/run-all.js",
    "test:agentdetect": "node scripts/test-agent-detect.js",
    "test:agentkit": "node scripts/test-agent-kit.js",
    "test:ailog": "node scripts/test-ailog-sessions.js",
    "test:ailog-timeline": "node scripts/test-ailog-timeline.js",
    "test:alive": "node scripts/test-alive-claims.js",
    "test:contradiction": "node scripts/test-contradiction.js",
    "test:costrollover": "node scripts/test-cost-rollover.js",
    "test:deathhp": "node scripts/test-death-hp.js",
    "test:deathreconcile": "node scripts/test-death-reconcile.js",
    "test:deathspot": "node scripts/test-death-spot.js",
    "test:games": "node scripts/test-games.js",
    "test:gradeblend": "node scripts/test-grade-blend.js",
    "test:habits": "node scripts/test-habits.js",
    "test:joke": "node scripts/test-joke-tips.js",
    "test:lol": "node scripts/test-lol.js",
    "test:lolgrader": "node scripts/test-lol-grader.js",
    "test:lolreview": "node scripts/test-lol-review.js",
    "test:maps": "node scripts/test-map-labels.js",
    "test:matchlink": "node scripts/test-match-link.js",
    "test:newmatch": "node scripts/test-new-match-reset.js",
    "test:profilemigration": "node scripts/test-profile-migration.js",
    "test:rejects": "node scripts/test-reject-reasons.js",
    "test:rivalsabilities": "node scripts/test-rivals-abilities.js",
    "test:rivalscomp": "node scripts/test-rivals-comp.js",
    "test:rivalsdraft": "node scripts/test-rivals-draft.js",
    "test:rivalsengine": "node scripts/test-rivals-engine.js",
    "test:rivalsknowledge": "node scripts/test-rivals-knowledge.js",
    "test:rivalslive": "node scripts/test-rivals-live.js",
    "test:rivalsmeta": "node scripts/test-rivals-meta.js",
    "test:rivalsreview": "node scripts/test-rivals-review.js",
    "test:rivalsroute": "node scripts/test-rivals-route.js",
    "test:scoreboard": "node scripts/test-scoreboard.js",
    "test:spectate": "node scripts/test-spectate.js",
    "test:statecontradiction": "node scripts/test-state-contradiction.js",
    "test:telemetry": "node scripts/test-telemetry.js",
    "test:tiptext": "node scripts/test-tip-text.js",
    "test:tipvisuals": "node scripts/test-tip-visuals.js",
    "test:variety": "node scripts/test-variety.js",
    "verify:ai": "node scripts/verify-ai.js",
    "verify:rivalsheroes": "node scripts/verify-rivals-heroes.js"
  },
  "build": {
    "appId": "com.ghostcoach.app2",
    "productName": "Occlara",
    "artifactName": "Occlara Setup.${ext}",
    "copyright": "Copyright © 2025 Occlara",
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/OcclaraCapture.exe",
        "to": "OcclaraCapture.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.games"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Occlara",
      "uninstallDisplayName": "Occlara",
      "include": "build/uninstaller.nsh"
    },
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "lowful",
      "repo": "GhostCoach-releases",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  },
  "keywords": [
    "electron",
    "gaming",
    "ai",
    "overlay",
    "coach"
  ],
  "author": "Occlara",
  "license": "MIT"
}
