  "build": {
    "appId": "com.ghostcoach.app2",
    "productName": "Occlara",
    "protocols": [
      {
        "name": "Occlara",
        "schemes": [
          "occlara"
        ]
      }
    ],
    "artifactName": "Occlara Setup.${ext}",
    "copyright": "Copyright © 2025 Occlara",
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/OcclaraCapture.exe",
        "to": "OcclaraCapture.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.games"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Occlara",
      "uninstallDisplayName": "Occlara",
      "include": "build/uninstaller.nsh"
    },
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "lowful",
      "repo": "GhostCoach-releases",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  },
  "keywords": [
    "electron",
    "gaming",
    "ai",
    "overlay",
    "coach"
  ],
  "author": "Occlara",
  "license": "UNLICENSED"
}
